// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// User — Created/upserted on Google OAuth callback
// Stores optional Slack credentials per-user (connected lazily)
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id               String     @id @default(cuid())
  googleId         String     @unique
  email            String     @unique
  name             String
  avatarUrl        String?
  /// Slack Bot token (chat:write scope) — null until user connects Slack
  slackAccessToken String?
  /// Slack incoming webhook URL — used if present (preferred over bot token)
  slackWebhookUrl  String?
  slackTeamId      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  senders          Sender[]
  emailJobs        EmailJob[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Sender — A "from" email address belonging to a user
// smtpConfig JSON allows flexible SMTP config per sender
// ─────────────────────────────────────────────────────────────────────────────
model Sender {
  id         String     @id @default(cuid())
  userId     String
  email      String
  /// JSON: { host: string, port: number, user: string, pass: string, secure: boolean }
  smtpConfig Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs  EmailJob[]

  @@unique([userId, email])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EmailJob — One row per recipient per scheduled send
//
// idempotencyKey: cuid() generated ONCE at creation, NEVER recomputed.
//   - Passed through all re-enqueues (rate-limit reschedule, startup reconciler)
//   - Processor Step 1 checks status by idempotencyKey before sending
//   - DB unique constraint prevents duplicate rows from retried API calls
//
// bullJobId: The BullMQ job ID in Redis. Null until successfully enqueued.
//   - Used by startupReconciler to check if job still exists in Redis
//   - Updated whenever we re-enqueue (rate-limit or reconcile)
// ─────────────────────────────────────────────────────────────────────────────
model EmailJob {
  id              String         @id @default(cuid())
  userId          String
  senderId        String
  recipientEmail  String
  subject         String
  body            String         @db.Text
  attachments     Json?
  scheduledAt     DateTime
  status          EmailJobStatus @default(scheduled)
  /// BullMQ job ID — null if server crashed before queue.add() succeeded
  bullJobId       String?
  /// Stable idempotency key — cuid() at row creation, never changes
  idempotencyKey  String         @unique
  sentAt          DateTime?
  /// Error message if status = 'failed'
  error           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          Sender         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([senderId, scheduledAt])
  @@index([bullJobId])
  @@index([status, scheduledAt])
}

enum EmailJobStatus {
  scheduled
  sent
  failed
  rate_limited
}
