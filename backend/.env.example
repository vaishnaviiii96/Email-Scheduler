# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Postgres via Docker Compose — port 5433 externally)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://emailscheduler:emailscheduler@localhost:5433/emailscheduler"

# Postgres Docker vars (used by docker-compose.yml)
POSTGRES_USER=emailscheduler
POSTGRES_PASSWORD=emailscheduler
POSTGRES_DB=emailscheduler

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────────────────
# ELASTICSEARCH
# ─────────────────────────────────────────────────────────────────────────────
ELASTICSEARCH_URL="http://localhost:9200"

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URI: http://localhost:4000/auth/google/callback
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# SLACK OAUTH (optional — rate limit notifications)
# 1. Create app at: https://api.slack.com/apps
# 2. Bot Token Scopes: incoming-webhook, chat:write
# 3. Redirect URI: http://localhost:4000/auth/slack/callback
# ─────────────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# ETHEREAL SMTP (fake SMTP for testing — auto-created if empty)
# Leave blank to auto-provision. Or log in at https://ethereal.email
# and paste credentials here for a persistent inbox.
# ─────────────────────────────────────────────────────────────────────────────
ETHEREAL_USER=
ETHEREAL_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — JWT secret shared between backend and frontend NextAuth
# Generate with: openssl rand -base64 32
# MUST be identical in backend/.env and frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_super_secret_min_32_chars_here

# ─────────────────────────────────────────────────────────────────────────────
# SERVER URLS
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# WORKER CONFIG
# ─────────────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ─────────────────────────────────────────────────────────────────────────────
# NODE ENV
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
