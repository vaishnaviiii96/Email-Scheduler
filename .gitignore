# ─────────────────────────────────────────────────────────────────────────────
# ON8 Email Scheduler — Root .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Environment files (NEVER commit these) ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── TypeScript cache ──────────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.kate-swp

# ── AI / Agent artifacts (internal tooling) ───────────────────────────────────
AGENTS.md
CLAUDE.md
.agents/
.gemini/

# ── Prisma ────────────────────────────────────────────────────────────────────
# Keep migrations — they are source of truth for schema history
# backend/prisma/migrations/

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────────────────────
.turbo/
.vercel/
.cache/
