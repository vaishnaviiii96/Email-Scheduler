# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Postgres via Docker Compose — port 5433 externally)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://emailscheduler:emailscheduler@localhost:5433/emailscheduler"

# Postgres Docker vars (used by docker-compose.yml)
POSTGRES_USER=emailscheduler
POSTGRES_PASSWORD=emailscheduler
POSTGRES_DB=emailscheduler

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────────────────
# ELASTICSEARCH
# ─────────────────────────────────────────────────────────────────────────────
ELASTICSEARCH_URL="http://localhost:9200"

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/auth/google/callback
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# SLACK OAUTH
# Create at: https://api.slack.com/apps
# Scopes: incoming-webhook, chat:write
# Redirect URI: http://localhost:4000/auth/slack/callback
# ─────────────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# ETHEREAL SMTP (optional — auto-created if empty)
# Auto-provisioned by nodemailer.createTestAccount() on first run.
# Leave empty for auto-creation, or fill in from https://ethereal.email
# ─────────────────────────────────────────────────────────────────────────────
ETHEREAL_USER=
ETHEREAL_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# AUTH (JWT secret — shared between backend and NextAuth)
# Generate: openssl rand -base64 32
# MUST be the same value in both backend/.env and frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_super_secret_min_32_chars_here

# ─────────────────────────────────────────────────────────────────────────────
# SERVER URLS
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# WORKER CONFIG
# ─────────────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ─────────────────────────────────────────────────────────────────────────────
# NODE ENV
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
